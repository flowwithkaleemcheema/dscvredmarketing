---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { site } from '../config/site';
---
<Base title={`Page not found | ${site.name}`} description="This page doesn't exist." path="/404" noindex>
  <main class="min-h-screen blueprint-grid grid place-items-center px-4 text-center">
    <div>
      <a href="/" aria-label="Home"><Logo /></a>
      <p class="mt-12 font-mono text-xs uppercase tracking-[0.16em] text-muted">Error 404</p>
      <h1 class="mt-3 text-5xl">This room hasn’t been built.</h1>
      <a href="/" class="btn btn-primary mt-10">Back to the homepage <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </main>
</Base>
