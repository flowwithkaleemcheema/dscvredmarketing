---
import SectionLabel from './SectionLabel.astro';
import { site } from '../config/site';
const { spotsLeft, totalSpots } = site.founding;
---
<section id="founding" class="py-24 lg:py-32 bg-paper-2/60 border-y border-line">
  <div class="container-x grid lg:grid-cols-12 gap-12 lg:gap-14 items-center">
    <div class="lg:col-span-6" data-reveal>
      <SectionLabel n="08">Exclusivity</SectionLabel>
      <h2 class="mt-5 text-4xl sm:text-5xl">One remodeler per market. When yours is taken, it’s gone.</h2>
      <p class="mt-5 text-lg text-body">
        We will never run ads for two competing remodelers in the same service area. It would be a conflict of interest,
        and it would hand your competitor the playbook. So once a market is claimed, it’s closed.
      </p>

      <!-- Territory illustration -->
      <figure class="mt-10 card overflow-hidden" aria-label="Illustration: a metro area divided into service areas, with one locked">
        <svg viewBox="0 0 520 240" class="w-full h-auto block">
          <rect width="520" height="240" fill="#ffffff" />
          <g stroke="#3d6b5a" stroke-opacity=".12" stroke-width="1">
            {Array.from({ length: 26 }, (_, i) => <line x1={i * 20} y1="0" x2={i * 20} y2="240" />)}
            {Array.from({ length: 12 }, (_, i) => <line x1="0" y1={i * 20} x2="520" y2={i * 20} />)}
          </g>
          <path d="M0 150 C 90 120, 160 190, 260 140 S 430 90, 520 120" stroke="#3d6b5a" stroke-opacity=".35" stroke-width="5" fill="none" />
          <path d="M120 0 L 170 240" stroke="#3d6b5a" stroke-opacity=".25" stroke-width="3" fill="none" />
          <path d="M380 0 L 350 240" stroke="#3d6b5a" stroke-opacity=".25" stroke-width="3" fill="none" />
          <circle cx="95" cy="80" r="52" fill="none" stroke="#5f6d66" stroke-dasharray="5 5" />
          <circle cx="430" cy="175" r="48" fill="none" stroke="#5f6d66" stroke-dasharray="5 5" />
          <circle cx="262" cy="110" r="66" fill="#c6f36b" fill-opacity=".35" stroke="#14302a" stroke-width="2" />
          <g transform="translate(262 104)">
            <rect x="-11" y="-6" width="22" height="17" rx="3" fill="#14302a" />
            <path d="M-6 -6 v-5 a6 6 0 0 1 12 0 v5" fill="none" stroke="#14302a" stroke-width="2.6" />
          </g>
          <text x="262" y="138" text-anchor="middle" font-family="JetBrains Mono Variable, monospace" font-size="10" font-weight="600" fill="#6f4520" letter-spacing="1">YOUR MARKET</text>
          <text x="95" y="84" text-anchor="middle" font-family="JetBrains Mono Variable, monospace" font-size="9.5" fill="#5f6d66" letter-spacing="1">OPEN</text>
          <text x="430" y="179" text-anchor="middle" font-family="JetBrains Mono Variable, monospace" font-size="9.5" fill="#5f6d66" letter-spacing="1">OPEN</text>
        </svg>
      </figure>
    </div>

    <div class="lg:col-span-6" data-reveal style="--d:100ms">
      <div class="relative rounded-[1.75rem] bg-ink text-paper/80 p-7 sm:p-10 overflow-hidden">
        <div class="absolute inset-0 blueprint-grid-dark opacity-60" aria-hidden="true"></div>
        <div class="relative">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-oak-light">Founding Partner Program</p>
              <h3 class="mt-3 text-3xl sm:text-4xl !text-paper">{totalSpots} remodelers. Then it closes.</h3>
            </div>
            <div class="flex-none text-center rounded-2xl border border-line-dark px-4 py-3">
              <p class="font-display text-4xl text-paper leading-none">{spotsLeft}</p>
              <p class="mt-1 font-mono text-[0.6rem] uppercase tracking-[0.14em] text-paper/50">of {totalSpots} open</p>
            </div>
          </div>
          <div class="mt-5 flex gap-1.5" aria-hidden="true">
            {Array.from({ length: totalSpots }, (_, i) => (
              <span class:list={['h-1.5 flex-1 rounded-full', i < totalSpots - spotsLeft ? 'bg-lime' : 'bg-line-dark']}></span>
            ))}
          </div>

          <p class="mt-7 text-paper/75">We’re new to remodeling, and we’d rather prove it than claim it. Our first three partners get founding terms in exchange for helping us build the case study.</p>

          <div class="mt-7 grid sm:grid-cols-2 gap-6">
            <div>
              <p class="text-sm font-semibold text-paper">You get</p>
              <ul class="mt-3 space-y-2.5 text-[0.95rem]">
                {['$3,000 setup fee waived', `The same ${site.offer.guaranteeCount}-in-${site.offer.guaranteeDays} guarantee`, 'A direct line to the founder', 'A say in how the system evolves'].map((t) => (
                  <li class="flex gap-2.5"><span class="text-oak-light">+</span>{t}</li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-sm font-semibold text-paper">We ask</p>
              <ul class="mt-3 space-y-2.5 text-[0.95rem]">
                {['Honest feedback, once a month', 'A short video testimonial and case study, only after we’ve hit your guarantee'].map((t) => (
                  <li class="flex gap-2.5"><span class="text-paper/50">→</span>{t}</li>
                ))}
              </ul>
            </div>
          </div>

          <button type="button" data-open-check data-source="founding" class="btn btn-primary mt-9 w-full sm:w-auto">
            Check if my market is open <span class="arrow" aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
