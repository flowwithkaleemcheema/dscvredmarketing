---
import SectionLabel from './SectionLabel.astro';
const yes = [
  'You’re a residential remodeler doing roughly $1–5M a year',
  'Your average project is $40k+ (kitchens, baths, whole-home)',
  'You can take on 2–4 more projects a month, or you’re ready to add a crew',
  'You can invest at least $3,000/month in ads',
  'You (or someone on your team) can call leads back the same hour',
  'You have happy clients and a 4.5★+ reputation worth showing off',
];
const no = [
  'Your average job is under $25k, or you’re mostly handyman work',
  'You only do new construction, commercial or insurance work',
  'You want “$50 leads” and treat marketing as a cost, not an investment',
  'You’re booked solid with no plan to grow',
  'Your reviews need work before anyone sends traffic your way',
];
---
<section id="fit" class="py-24 lg:py-32 bg-paper-2/60 border-y border-line">
  <div class="container-x">
    <div class="max-w-3xl" data-reveal>
      <SectionLabel n="10">Fit</SectionLabel>
      <h2 class="mt-5 text-4xl sm:text-5xl">We’re picky, because the guarantee depends on it.</h2>
    </div>
    <div class="mt-12 grid md:grid-cols-2 gap-5 lg:gap-6">
      <div class="card p-7 sm:p-9 border-sage/40" data-reveal>
        <p class="font-display text-2xl text-ink">This is for you if…</p>
        <ul class="mt-6 space-y-3.5">
          {yes.map((t) => (
            <li class="flex gap-3">
              <span class="grid place-items-center size-6 rounded-full bg-sage-soft text-sage flex-none mt-0.5">
                <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" /></svg>
              </span>
              <span class="text-ink">{t}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-[1.25rem] border border-line p-7 sm:p-9" data-reveal style="--d:80ms">
        <p class="font-display text-2xl text-ink">This isn’t for you if…</p>
        <ul class="mt-6 space-y-3.5">
          {no.map((t) => (
            <li class="flex gap-3">
              <span class="grid place-items-center size-6 rounded-full bg-paper-2 text-muted flex-none mt-0.5">
                <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6.3 5 5 6.3 8.7 10 5 13.7 6.3 15l3.7-3.7 3.7 3.7 1.3-1.3-3.7-3.7L15 6.3 13.7 5 10 8.7z" /></svg>
              </span>
              <span class="text-body">{t}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
