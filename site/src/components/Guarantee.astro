---
import SectionLabel from './SectionLabel.astro';
import Seal from './Seal.astro';
import { site } from '../config/site';
const { guaranteeCount: n, guaranteeDays: d, minBudget, minAdSpend } = site.offer;
const qualified = [
  'A homeowner, with the decision maker at the consultation',
  'Inside your agreed service area',
  'Wants a project type you actually do',
  `Stated budget at or above your minimum (default $${(minBudget / 1000).toFixed(0)}k+)`,
  'Planning to start within 6 months',
  'Booked on your calendar, in-home or virtual',
];
const yours = [
  { t: 'Keep your ads running', b: `At least $${minAdSpend.toLocaleString('en-US')}/month in ad spend for the full ${d} days. No pausing.` },
  { t: 'Call your leads back', b: 'Within 15 minutes during business hours. We alert you instantly, or the booking flow schedules for you.' },
  { t: 'Keep the door open', b: 'At least 4 consultation slots a week on your calendar, and show up to the ones that get booked.' },
];
---
<section id="guarantee" class="py-24 lg:py-32 relative overflow-hidden">
  <div class="container-x">
    <div class="max-w-4xl mx-auto text-center" data-reveal>
      <Seal class="mx-auto drop-shadow-[0_18px_30px_rgba(173,71,33,.35)]" />
      <div class="mt-8 flex justify-center"><SectionLabel n="07">The guarantee</SectionLabel></div>
      <h2 class="mt-5 text-4xl sm:text-5xl lg:text-[3.6rem]">
        {n} qualified consultations in {d} days.{' '}
        <span class="italic text-clay font-[380]">Or we work for free until you get them.</span>
      </h2>
      <p class="mt-6 text-lg sm:text-xl text-body max-w-2xl mx-auto">
        If we fall short, you stop paying our management fee and we keep working until the {n}th qualified homeowner is on your calendar.
        No refund forms, no arguments. We agree on what “qualified” means before we start.
      </p>
    </div>

    <div class="mt-16 grid lg:grid-cols-2 gap-5 lg:gap-6 max-w-5xl mx-auto">
      <div class="card p-7 sm:p-9" data-reveal>
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-clay">What counts as qualified</p>
        <ul class="mt-5 space-y-3.5">
          {qualified.map((q) => (
            <li class="flex gap-3 text-ink">
              <svg class="size-5 mt-0.5 flex-none text-sage" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" /></svg>
              {q}
            </li>
          ))}
        </ul>
      </div>
      <div class="card p-7 sm:p-9" data-reveal style="--d:80ms">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-clay">Your side of the deal</p>
        <p class="mt-2 text-body text-[0.95rem]">Three things any serious remodeler already does:</p>
        <ol class="mt-5 space-y-5">
          {yours.map((y, i) => (
            <li class="flex gap-4">
              <span class="grid place-items-center size-8 rounded-full bg-ink text-paper font-mono text-sm flex-none">{i + 1}</span>
              <div>
                <p class="font-semibold text-ink">{y.t}</p>
                <p class="text-[0.95rem] text-body">{y.b}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
    <p class="mt-8 text-center font-mono text-xs uppercase tracking-[0.14em] text-muted" data-reveal>
      The {d}-day clock starts the day your ads go live, not the day you sign.
    </p>
  </div>
</section>
