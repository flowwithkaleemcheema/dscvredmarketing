---
import { site } from '../config/site';
const { spotsLeft, totalSpots } = site.founding;
---
{spotsLeft > 0 && (
  <a href="#founding" class="block bg-ink text-paper/90 hover:text-paper transition-colors">
    <div class="container-x flex items-center justify-center gap-3 py-2.5 text-[0.8rem] sm:text-sm text-center">
      <span class="relative flex size-2 flex-none">
        <span class="pulse-dot absolute inset-0 rounded-full bg-[#7fb38f]"></span>
      </span>
      <span>
        <strong class="font-semibold text-paper">Founding Partner Program:</strong>{' '}
        <span class="hidden sm:inline">{spotsLeft} of {totalSpots} spots open · setup fee waived · one remodeler per market</span>
        <span class="sm:hidden">{spotsLeft} of {totalSpots} spots open, setup fee waived</span>
      </span>
      <span aria-hidden="true" class="text-brass">→</span>
    </div>
  </a>
)}
