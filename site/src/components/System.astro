---
import SectionLabel from './SectionLabel.astro';
import { site } from '../config/site';

const steps = [
  {
    k: 'Attract',
    name: 'Exclusive Homeowner Ad Engine',
    body: 'Google Search, Local Services Ads, Facebook and Instagram, built around your portfolio and aimed at homeowners in your service area who are searching right now. “DIY”, “cheap” and “cost to” bargain hunters get filtered out at the keyword level.',
  },
  {
    k: 'Qualify',
    name: 'Remodel Consultation Funnel',
    body: 'Landing pages that sell your craftsmanship, then ask about project type, budget and timeline before anyone gets near your calendar. Price shoppers sort themselves out.',
  },
  {
    k: 'Respond',
    name: '5-Minute Speed-to-Lead',
    body: 'Every new lead gets a personal text in under five minutes, nights and weekends included, while you’re on a job site. Missed a call? They get a text back automatically.',
  },
  {
    k: 'Book',
    name: 'Show-Up System',
    body: 'Qualified homeowners pick a slot on your calendar. Confirmations, reminders and a “what to expect” message do the chasing, so they show up ready to talk scope.',
  },
  {
    k: 'Measure',
    name: 'Live Project ROI Dashboard',
    body: 'Spend → leads → consultations → signed projects → revenue. One screen, updated live. You’ll know your cost per signed project, not your “impressions.”',
  },
];
---
<section id="system" class="relative bg-ink text-paper/80 py-24 lg:py-32 overflow-hidden">
  <div class="absolute inset-0 blueprint-grid-dark [mask-image:linear-gradient(to_bottom,#000,transparent_60%)]" aria-hidden="true"></div>
  <div class="container-x relative">
    <div class="max-w-3xl" data-reveal>
      <SectionLabel n="03" tone="light">How it works</SectionLabel>
      <h2 class="mt-5 text-4xl sm:text-5xl lg:text-[3.5rem] !text-paper">{site.offer.name}</h2>
      <p class="mt-6 text-lg sm:text-xl text-paper/70 max-w-2xl">
        Five connected parts that turn strangers searching “kitchen remodel near me” into homeowners sitting across your table. We build it, run it and answer for it.
      </p>
    </div>

    <div class="mt-16 lg:mt-20 relative">
    <div class="hidden lg:block absolute left-[1.45rem] top-4 bottom-4 w-px bg-gradient-to-b from-line-dark via-oak-light/40 to-line-dark" aria-hidden="true"></div>
    <ol>
      {steps.map((s, i) => (
        <li class="relative grid lg:grid-cols-12 gap-8 lg:gap-12 py-10 lg:py-12 border-t border-line-dark first:border-t-0 items-center" data-reveal>
          <div class="lg:col-span-6 lg:pl-20 relative">
            <span class="hidden lg:grid absolute left-0 top-0 size-[2.9rem] place-items-center rounded-full border border-oak-light/50 bg-ink font-mono text-sm text-oak-light">0{i + 1}</span>
            <p class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-oak-light"><span class="lg:hidden">0{i + 1} · </span>{s.k}</p>
            <h3 class="mt-2 text-3xl sm:text-[2.1rem] !text-paper">{s.name}</h3>
            <p class="mt-4 text-[1.05rem] leading-relaxed text-paper/70 max-w-lg">{s.body}</p>
          </div>
          <div class="lg:col-span-6">
            <div class="rounded-2xl border border-line-dark bg-ink-2 p-5 sm:p-6 shadow-[0_30px_60px_-30px_rgba(0,0,0,.6)]">
              {i === 0 && (
                <div>
                  <div class="flex items-center gap-3 rounded-full bg-ink-3 border border-line-dark px-4 py-2.5 text-sm text-paper/85">
                    <svg class="size-4 text-paper/50" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="9" r="6" /><path d="m14 14 4 4" /></svg>
                    kitchen remodel near me
                  </div>
                  <div class="mt-4 rounded-xl bg-paper text-ink p-4">
                    <p class="text-[0.7rem] font-semibold text-ink/60">Sponsored · yourcompany.com</p>
                    <p class="mt-1 text-[1.05rem] font-semibold text-[#1a3d8f] leading-snug">Design-Build Kitchen Remodels in Plano | Free Design Consultation</p>
                    <p class="mt-1 text-sm text-body">★★★★★ 4.9 (127 reviews) · Licensed &amp; insured · See 40+ finished kitchens</p>
                  </div>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {['Google Search', 'Local Services Ads', 'Facebook', 'Instagram'].map((c) => (
                      <span class="rounded-full border border-line-dark px-3 py-1 text-xs text-paper/75">{c}</span>
                    ))}
                  </div>
                </div>
              )}
              {i === 1 && (
                <div class="grid sm:grid-cols-2 gap-5">
                  <div>
                    <p class="text-sm font-semibold text-paper">What’s your budget for this project?</p>
                    <ul class="mt-3 space-y-2 text-sm">
                      {[['Under $25k', 'out'], ['$25k – $50k', ''], ['$50k – $100k', 'on'], ['$100k+', '']].map(([l, st]) => (
                        <li class:list={[
                          'rounded-lg px-3 py-2 border flex items-center justify-between',
                          st === 'on' ? 'border-lime bg-lime/10 text-paper' : 'border-line-dark text-paper/70',
                          st === 'out' && 'line-through opacity-45',
                        ]}>{l}{st === 'on' && <span class="text-lime">✓</span>}</li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-paper">When would you like to start?</p>
                    <ul class="mt-3 space-y-2 text-sm">
                      {[['ASAP', ''], ['1–3 months', 'on'], ['3–6 months', ''], ['Just researching', 'out']].map(([l, st]) => (
                        <li class:list={[
                          'rounded-lg px-3 py-2 border flex items-center justify-between',
                          st === 'on' ? 'border-lime bg-lime/10 text-paper' : 'border-line-dark text-paper/70',
                          st === 'out' && 'line-through opacity-45',
                        ]}>{l}{st === 'on' && <span class="text-lime">✓</span>}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}
              {i === 2 && (
                <ol class="space-y-0">
                  {[
                    ['2:14:05 PM', 'New lead: Kitchen remodel, budget $60–90k', 'text-paper/85'],
                    ['2:14:46 PM', 'Personal text sent to homeowner', 'text-[#8fc3a0]'],
                    ['2:14:47 PM', 'You get an alert with their details', 'text-paper/85'],
                    ['2:19:12 PM', 'Homeowner replies, picks a consultation time', 'text-oak-light'],
                  ].map(([t, d, c], j) => (
                    <li class="relative flex gap-4 pb-5 last:pb-0">
                      {j < 3 && <span class="absolute left-[0.3rem] top-4 bottom-0 w-px bg-line-dark" aria-hidden="true"></span>}
                      <span class="relative mt-1.5 size-[0.65rem] rounded-full bg-ink-2 border-2 border-oak-light flex-none"></span>
                      <div>
                        <p class="font-mono text-[0.7rem] text-paper/50">{t}</p>
                        <p class={`text-[0.95rem] ${c}`}>{d}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              )}
              {i === 3 && (
                <div>
                  <div class="grid grid-cols-5 gap-2 text-center">
                    {['Mon', 'Tue', 'Wed', 'Thu', 'Fri'].map((d, j) => (
                      <div>
                        <p class="font-mono text-[0.65rem] uppercase text-paper/50">{d}</p>
                        <div class="mt-2 space-y-1.5">
                          {[0, 1, 2].map((k) => {
                            const booked = (j + k) % 3 === 0 || (j === 3 && k === 1);
                            return <div class:list={['h-7 rounded-md text-[0.62rem] grid place-items-center', booked ? 'bg-lime text-ink font-semibold' : 'border border-dashed border-line-dark text-paper/30']}>{booked ? 'Booked' : 'Open'}</div>;
                          })}
                        </div>
                      </div>
                    ))}
                  </div>
                  <div class="mt-5 flex flex-wrap gap-2">
                    {['✓ Confirmation sent', '⏱ Reminder 24h before', '⏱ Reminder 2h before'].map((c) => (
                      <span class="rounded-full bg-ink-3 px-3 py-1 text-xs text-paper/75">{c}</span>
                    ))}
                  </div>
                </div>
              )}
              {i === 4 && (
                <div>
                  {[
                    ['Ad spend', '$3,000', 100],
                    ['Qualified leads', '24', 78],
                    ['Booked consultations', '9', 52],
                    ['Signed projects', '2', 30],
                  ].map(([l, v, w]) => (
                    <div class="flex items-center gap-3 py-1.5">
                      <p class="w-[44%] sm:w-40 flex-none text-sm text-paper/70">{l}</p>
                      <div class="flex-1 h-7 rounded-md bg-ink-3 overflow-hidden">
                        <div class="h-full rounded-md bg-gradient-to-r from-lime-dark to-lime flex items-center justify-end pr-2.5 text-xs font-semibold text-ink" style={`width:${w}%`}>{v}</div>
                      </div>
                    </div>
                  ))}
                  <div class="mt-4 pt-4 border-t border-line-dark flex items-end justify-between">
                    <p class="text-sm text-paper/60">Signed revenue this month</p>
                    <p class="font-display text-3xl text-paper">$148,000</p>
                  </div>
                  <p class="mt-3 font-mono text-[0.62rem] uppercase tracking-[0.12em] text-paper/40">Illustrative month · not a real client</p>
                </div>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>
    </div>
  </div>
</section>
