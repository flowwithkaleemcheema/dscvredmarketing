---
import SectionLabel from './SectionLabel.astro';
// Illustrative "referral-only" pipeline across a year (projects in pipeline per month)
const months = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
const pipeline = [2, 1, 4, 7, 6, 3, 2, 6, 8, 5, 3, 1];
const W = 320, H = 150, pad = 14;
const x = (i: number) => pad + (i * (W - pad * 2)) / (months.length - 1);
const y = (v: number) => H - 22 - (v / 9) * (H - 40);
const path = pipeline.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
const area = `${path} L${x(11)} ${H - 22} L${x(0)} ${H - 22} Z`;
const capacity = y(5.5);

const pains = [
  { t: 'Leads sit for hours', d: 'because you’re on a job site, and by the time you call, they’ve talked to three other contractors.' },
  { t: 'Estimates go quiet', d: 'and nobody follows up. Thousands in signed work sitting in “we’ll think about it.”' },
  { t: 'Agencies report clicks', d: 'impressions and “reach.” You wanted signed projects. Nobody could tell you what you got for the money.' },
];
---
<section id="problem" class="py-24 lg:py-32">
  <div class="container-x">
    <div class="max-w-3xl" data-reveal>
      <SectionLabel n="01">The problem</SectionLabel>
      <h2 class="mt-5 text-4xl sm:text-5xl lg:text-[3.5rem]">You're great at building. Your pipeline was never built.</h2>
      <p class="mt-6 text-lg sm:text-xl text-body max-w-2xl">
        Most remodelers we talk to run on two lead sources: referrals and rented lead platforms.
        One you can't control. The other you're sharing with four competitors.
      </p>
    </div>

    <div class="mt-14 grid md:grid-cols-2 gap-5 lg:gap-6">
      <!-- Feast or famine -->
      <article class="card p-6 sm:p-8 flex flex-col" data-reveal>
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-oak">Referrals</p>
        <h3 class="mt-2 text-2xl sm:text-3xl">Feast or famine.</h3>
        <svg viewBox={`0 0 ${W} ${H}`} class="mt-6 w-full h-auto" role="img" aria-label="Illustrative chart: a referral-only pipeline swings from busy to empty, with a deep gap in January and February">
          <defs>
            <linearGradient id="feast" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="#a36b37" stop-opacity=".2" /><stop offset="1" stop-color="#a36b37" stop-opacity="0" />
            </linearGradient>
          </defs>
          <line x1={pad} x2={W - pad} y1={capacity} y2={capacity} stroke="#3d6b5a" stroke-width="1" stroke-dasharray="4 4" opacity=".55" />
          <line x1={W - pad - 92} x2={W - pad - 76} y1="9" y2="9" stroke="#3d6b5a" stroke-dasharray="4 3" opacity=".7" />
          <text x={W - pad} y="12" text-anchor="end" font-family="JetBrains Mono Variable, monospace" font-size="8.5" fill="#3d6b5a" opacity=".8">CREW CAPACITY</text>
          <path d={area} fill="url(#feast)" />
          <path d={path} fill="none" stroke="#a36b37" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" />
          {pipeline.map((v, i) => <circle cx={x(i)} cy={y(v)} r="2.6" fill="#ffffff" stroke="#a36b37" stroke-width="1.6" />)}
          <rect x={x(0) - 8} y={22} width={x(1) - x(0) + 16} height={H - 44} rx="6" fill="#14302a" opacity=".05" />
          <text x={x(0) - 4} y={34} font-family="JetBrains Mono Variable, monospace" font-size="8.5" fill="#14302a" opacity=".7">THE JANUARY GAP</text>
          {months.map((m, i) => <text x={x(i)} y={H - 5} text-anchor="middle" font-family="JetBrains Mono Variable, monospace" font-size="9" fill="#5f6d66">{m}</text>)}
        </svg>
        <blockquote class="mt-6 pt-6 border-t border-line font-display text-xl font-semibold tracking-[-0.02em] text-ink leading-snug">
          “When referrals are flowing we're slammed. When they dry up, we scramble.”
        </blockquote>
      </article>

      <!-- Shared leads -->
      <article class="card p-6 sm:p-8 flex flex-col" data-reveal style="--d:80ms">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-oak">Shared lead platforms</p>
        <h3 class="mt-2 text-2xl sm:text-3xl">A race to the bottom.</h3>
        <svg viewBox="0 0 320 150" class="mt-6 w-full h-auto" role="img" aria-label="Diagram: one homeowner lead is sold to five contractors at once">
          {[
            [40, 28, 'Contractor A'], [40, 122, 'Contractor B'], [280, 28, 'Contractor C'], [280, 122, 'Contractor D'],
          ].map(([cx, cy, l]) => (
            <g>
              <line x1="160" y1="75" x2={cx} y2={cy} stroke="#5f6d66" stroke-width="1" stroke-dasharray="3 3" />
              <rect x={Number(cx) - 34} y={Number(cy) - 11} width="68" height="22" rx="11" fill="#ffffff" stroke="#dce3dd" />
              <text x={cx} y={Number(cy) + 3.5} text-anchor="middle" font-family="Instrument Sans Variable, sans-serif" font-size="9.5" fill="#3d4a44">{l}</text>
            </g>
          ))}
          <line x1="160" y1="75" x2="160" y2="138" stroke="#a36b37" stroke-width="1.2" stroke-dasharray="3 3" />
          <rect x="114" y="127" width="92" height="22" rx="11" fill="#f4e6d6" stroke="#a36b37" />
          <text x="160" y="141.5" text-anchor="middle" font-family="Instrument Sans Variable, sans-serif" font-size="9.5" font-weight="600" fill="#6f4520">You · 3 hrs later</text>
          <circle cx="160" cy="70" r="34" fill="#14302a" />
          <text x="160" y="67" text-anchor="middle" font-family="Instrument Sans Variable, sans-serif" font-size="9" font-weight="600" fill="#fafaf8">1 homeowner</text>
          <text x="160" y="79" text-anchor="middle" font-family="JetBrains Mono Variable, monospace" font-size="7.5" fill="#d9a877">SOLD ×5</text>
        </svg>
        <blockquote class="mt-6 pt-6 border-t border-line font-display text-xl font-semibold tracking-[-0.02em] text-ink leading-snug">
          “They sell the same lead to four other guys. Half of them are just shopping prices.”
        </blockquote>
      </article>
    </div>

    <div class="mt-5 lg:mt-6 grid sm:grid-cols-3 gap-5 lg:gap-6">
      {pains.map((p, i) => (
        <div class="rounded-2xl border border-line p-6" data-reveal style={`--d:${i * 70}ms`}>
          <p class="font-semibold text-ink">{p.t}</p>
          <p class="mt-1.5 text-[0.95rem] text-body leading-relaxed">{p.d}</p>
        </div>
      ))}
    </div>

    <p class="mt-16 lg:mt-20 max-w-4xl font-display text-[1.75rem] sm:text-4xl leading-[1.2] text-ink tracking-[-0.015em]" data-reveal>
      None of this is a sales problem. You close fine in the home.{' '}
      <span class="text-muted">It's a system problem, and systems can be built.</span>
    </p>
  </div>
</section>
